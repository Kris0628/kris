const NHI_THRESHOLD = 20000;
const NHI_RATE = 0.0211;
const MONTH_NAMES = ["1月","2月","3月","4月","5月","6月","7月","8月","9月","10月","11月","12月"];

let suppressLink = false; // 避免程式設值觸發連鎖重算造成迴圈

function fmt(n, d=0){
  return Number(n).toLocaleString('zh-TW', {minimumFractionDigits:d, maximumFractionDigits:d});
}

function getEtf(groupIdx, id){
  return GROUPS[groupIdx].options[id];
}

function buildCard(idx){
  const g = GROUPS[idx];
  const ids = Object.keys(g.options);
  const card = document.createElement('div');
  card.className = 'etf-card';
  card.innerHTML = `
    <div class="group-badge">${g.label}</div>
    <select id="sel${idx}" onchange="onSelectChange(${idx})">
      ${ids.map(id=>`<option value="${id}" ${id===g.default?'selected':''}>${id} ${g.options[id].name}</option>`).join('')}
    </select>
    <div class="etf-name" id="name${idx}"></div>
    <div class="etf-code" id="code${idx}"></div>
    <div class="etf-desc" id="desc${idx}"></div>
    <div class="etf-meta">
      <div><span>投信公司</span><b id="issuer${idx}"></b></div>
      <div><span>成立日期</span><b id="incep${idx}"></b></div>
      <div><span>資產規模</span><b id="aum${idx}"></b></div>
      <div><span>受益人數</span><b id="holders${idx}"></b></div>
      <div><span>目前股價</span><b id="price${idx}"></b></div>
      <div><span>單季配息(估)</span><b id="qdiv${idx}"></b></div>
      <div><span>近期殖利率</span><b id="yld${idx}"></b></div>
    </div>
    <div class="shares-row">
      <label>股數</label>
      <input type="number" id="shares${idx}" value="0" min="0" step="1" oninput="onSharesInput(${idx})">
    </div>
    <div class="lot-note" id="lot${idx}"></div>
    <div class="cost-line"><span>投入金額</span><span id="cost${idx}">NT$ 0</span></div>
  `;
  return card;
}

function refreshCardInfo(idx){
  const id = document.getElementById(`sel${idx}`).value;
  const e = getEtf(idx, id);
  document.getElementById(`name${idx}`).textContent = e.name;
  document.getElementById(`code${idx}`).textContent = id + " · " + e.tracker;
  document.getElementById(`desc${idx}`).textContent = e.desc;
  document.getElementById(`issuer${idx}`).textContent = e.issuer;
  document.getElementById(`incep${idx}`).textContent = e.inception;
  document.getElementById(`aum${idx}`).textContent = e.aum;
  document.getElementById(`holders${idx}`).textContent = e.holders;
  document.getElementById(`price${idx}`).textContent = "NT$ " + e.price.toFixed(2);
  document.getElementById(`qdiv${idx}`).textContent = e.qDiv.toFixed(2) + " 元/股";
  document.getElementById(`yld${idx}`).textContent = e.yieldPct.toFixed(1) + "%";
}

function onSelectChange(idx){
  refreshCardInfo(idx);
  autoAllocate(); // 換ETF後，用門檻邏輯重新配平三檔，確保仍用滿預算
}

function currentSelection(){
  return [0,1,2].map(i=>{
    const id = document.getElementById(`sel${i}`).value;
    const shares = parseFloat(document.getElementById(`shares${i}`).value) || 0;
    return {idx:i, id, shares, ...getEtf(i,id), payMonths: GROUPS[i].payMonths};
  });
}

// 三檔一起做「等額配息」水位法配平，讓三檔單季配息盡量拉平（在門檻之下）
function waterFillAllocate(total, ks){
  const sumK = ks.reduce((a,b)=>a+b,0);
  const D = total / sumK;
  return ks.map(k => D*k);
}

function autoAllocate(){
  const total = parseFloat(document.getElementById('investAmount').value) || 0;
  const sel = currentSelection();
  const ks = sel.map(e => e.price / e.qDiv);
  const moneys = waterFillAllocate(total, ks);
  sel.forEach((e,i)=>{
    const shares = Math.max(0, Math.round(moneys[i] / e.price));
    document.getElementById(`shares${e.idx}`).value = shares;
  });
  recalc();
}

// 使用者手動調整某一檔股數時，剩餘預算在「另外兩檔」之間用同樣的等額配息邏輯重新配平
function onSharesInput(changedIdx){
  if(suppressLink){ recalc(); return; }
  const total = parseFloat(document.getElementById('investAmount').value) || 0;
  const sel = currentSelection();

  const changed = sel[changedIdx];
  const cost = changed.shares * changed.price;
  const others = sel.filter(e=>e.idx!==changedIdx);
  const remaining = total - cost;

  suppressLink = true;
  if(remaining <= 0){
    others.forEach(e=>{ document.getElementById(`shares${e.idx}`).value = 0; });
  } else {
    const ks = others.map(e => e.price / e.qDiv);
    const moneys = waterFillAllocate(remaining, ks);
    others.forEach((e,i)=>{
      const shares = Math.max(0, Math.round(moneys[i] / e.price));
      document.getElementById(`shares${e.idx}`).value = shares;
    });
  }
  suppressLink = false;
  recalc();
}

function recalc(){
  const total = parseFloat(document.getElementById('investAmount').value) || 0;
  const sel = currentSelection();

  let totalCost = 0, totalQDiv = 0, totalTax = 0, totalNet = 0;
  const qBody = document.getElementById('quarterBody');
  qBody.innerHTML = '';

  sel.forEach(e=>{
    const cost = e.shares * e.price;
    const qdiv = e.shares * e.qDiv;
    const taxed = qdiv >= NHI_THRESHOLD;
    const tax = taxed ? qdiv * NHI_RATE : 0;
    const net = qdiv - tax;

    totalCost += cost; totalQDiv += qdiv; totalTax += tax; totalNet += net;

    document.getElementById(`cost${e.idx}`).textContent = "NT$ " + fmt(cost);
    document.getElementById(`lot${e.idx}`).textContent = `約 ${(e.shares/1000).toFixed(2)} 張`;

    const row = document.createElement('tr');
    row.innerHTML = `
      <td>${e.id} ${e.name}</td>
      <td>${fmt(e.shares)}</td>
      <td>NT$ ${fmt(qdiv)}</td>
      <td>${taxed ? '<span class="tag-tax">達2萬門檻</span>' : '<span class="tag-safe">低於門檻</span>'}</td>
      <td>${taxed ? '– NT$ ' + fmt(tax) : '—'}</td>
      <td>NT$ ${fmt(net)}</td>
    `;
    qBody.appendChild(row);
  });

  document.getElementById('quarterFoot').innerHTML = `
    <tr class="total">
      <td>合計（單季）</td><td></td>
      <td>NT$ ${fmt(totalQDiv)}</td><td></td>
      <td>${totalTax>0 ? '– NT$ '+fmt(totalTax) : '—'}</td>
      <td>NT$ ${fmt(totalNet)}</td>
    </tr>`;

  const remaining = total - totalCost;
  const budgetBar = document.getElementById('budgetBar');
  budgetBar.innerHTML = `
    <div class="budget-item"><span class="lab">總投入金額</span><span class="val">NT$ ${fmt(total)}</span></div>
    <div class="budget-item"><span class="lab">目前已配置</span><span class="val">NT$ ${fmt(totalCost)}</span></div>
    <div class="budget-item"><span class="lab">${remaining>=0?'剩餘可配置':'超出預算'}</span><span class="val ${remaining>=0?'ok':'over'}">NT$ ${fmt(Math.abs(remaining))}</span></div>
    <div class="budget-item"><span class="lab">年化配息(稅前估)</span><span class="val">NT$ ${fmt(totalQDiv*4)}</span></div>
    <div class="budget-item"><span class="lab">年化補充保費(估)</span><span class="val" style="color:var(--amber)">NT$ ${fmt(totalTax*4)}</span></div>
    <div class="budget-item"><span class="lab">年化實領(估)</span><span class="val" style="color:var(--green)">NT$ ${fmt(totalNet*4)}</span></div>
  `;

  buildCalendar(sel);
  buildNotes();
}

function buildCalendar(sel){
  const cal = document.getElementById('calendar');
  cal.innerHTML = '';
  for(let m=1;m<=12;m++){
    let amt = 0, tax = 0;
    sel.forEach(e=>{
      if(e.payMonths.includes(m)){
        const qdiv = e.shares * e.qDiv;
        const taxed = qdiv >= NHI_THRESHOLD;
        const t = taxed ? qdiv*NHI_RATE : 0;
        amt += (qdiv - t);
        tax += t;
      }
    });
    const div = document.createElement('div');
    div.className = 'month' + (amt>0 ? ' has-pay' : '');
    div.innerHTML = amt>0
      ? `<div class="m-label">${MONTH_NAMES[m-1]}</div><div class="m-amt">NT$ ${fmt(amt)}</div>${tax>0?`<div class="m-tax">已扣補充保費 NT$ ${fmt(tax)}</div>`:''}`
      : `<div class="m-label">${MONTH_NAMES[m-1]}</div><div class="m-empty">無配息</div>`;
    cal.appendChild(div);
  }
}

function buildNotes(){
  document.getElementById('notes').innerHTML = `
    <b>資料與試算說明</b><br>
    · ETF股價、單季配息金額與殖利率為 2026/07/08～07/09 期間彙整之公開市場資訊（Yahoo股市、Goodinfo、各投信官網等），僅供規劃參考，實際配息金額、除息與發放日期一律以各投信正式公告為準，過去配息不代表未來配息保證。<br>
    · 資產規模與受益人數取自臺灣證券交易所ETF e添富平台（資料日期約2026/07/09，來源集保結算所），成立日期取自各投信公開說明書與公開報導；規模與人數每日都在變動，僅反映查詢當下的快照，實際數字請以投信官網或集保結算所最新公告為準。<br>
    · 三個欄位已依「現金股利實際入帳月份」固定分組（並非除息交易日月份，兩者常相差約1個月，證交所配息行事曆本身也是以除息日月份分類，須留意）：第一欄（00713／00919／00915）在1、4、7、10月入帳；第二欄（0056）在2、5、8、11月入帳；第三欄（00878／00850／00891／00894）在3、6、9、12月入帳，三檔搭配可讓全年多達8～12個月份都有配息落袋。<br>
    · 市面上常被歸類為「2、5、8、11月配息」的00878、00850、00731、00894、00891等ETF，其實指的是除息交易日月份；實際現金股利發放日多半落後1個月，落在3、6、9、12月（因此本工具將它們歸入第三欄）。目前查證到的主流高股息ETF中，只有0056是真正在2、5、8、11月將現金存入戶頭，若日後找到其他同組標的會再補充。<br>
    · 調整任一檔股數時，其餘兩檔會自動依「等額配息水位法」重新配平剩餘預算，讓總投入金額盡量貼齊你輸入的投資金額，同時盡量把三檔的單季配息拉到同一水準，降低任一檔獨自衝上2萬元門檻的機率。<br>
    · 二代健保補充保費現行規定（2026年）：股利所得單筆給付達新台幣2萬元（含）即按 2.11% 扣繳「全額」，非僅扣超過部分；單筆給付上限1,000萬元。「年度累計制」修法討論已暫緩，若日後上路，試算邏輯需再調整，請留意衛福部最新公告。<br>
    · 本工具僅為教育與資產配置參考，不構成投資建議，投資有風險，請依自身風險承受度審慎評估。
  `;
}

function init(){
  const grid = document.getElementById('etfGrid');
  for(let i=0;i<3;i++) grid.appendChild(buildCard(i));
  for(let i=0;i<3;i++) refreshCardInfo(i);
  autoAllocate();
  document.getElementById('investAmount').addEventListener('input', autoAllocate);
}

init();
</script>
