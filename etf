<!DOCTYPE html>
<html lang="zh-Hant">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>季配息 ETF 資產配置試算</title>
<style>
@import url('https://fonts.googleapis.com/css2?family=Newsreader:ital,wght@0,400;0,500;0,600;1,400&family=JetBrains+Mono:wght@400;500;700&family=Noto+Sans+TC:wght@400;500;700&display=swap');

:root{
  --bg:#12171c;
  --panel:#1a2129;
  --panel2:#212a33;
  --line:#2c3742;
  --gold:#c9a961;
  --gold-dim:#8a7644;
  --text:#e9e6df;
  --sub:#8b98a4;
  --green:#5fae82;
  --amber:#e0a458;
  --red:#d9756b;
}
*{box-sizing:border-box;}
body{
  margin:0;
  background:var(--bg);
  color:var(--text);
  font-family:'Noto Sans TC','Segoe UI',sans-serif;
  line-height:1.5;
  padding-bottom:60px;
}
.wrap{max-width:1120px;margin:0 auto;padding:36px 20px 0;}
header{margin-bottom:28px;border-bottom:1px solid var(--line);padding-bottom:22px;}
h1{
  font-family:'Newsreader',serif;
  font-weight:500;
  font-size:2.05rem;
  margin:0 0 6px;
  letter-spacing:.3px;
}
h1 span{color:var(--gold);font-style:italic;}
.sub{color:var(--sub);font-size:.92rem;max-width:680px;}
.tag{display:inline-block;font-family:'JetBrains Mono',monospace;font-size:.7rem;color:var(--gold);border:1px solid var(--gold-dim);padding:2px 8px;border-radius:20px;margin-bottom:10px;letter-spacing:.5px;}

.section-label{
  font-family:'JetBrains Mono',monospace;
  font-size:.72rem;
  color:var(--gold);
  text-transform:uppercase;
  letter-spacing:1.5px;
  margin:34px 0 12px;
  display:flex;align-items:center;gap:10px;
}
.section-label::after{content:'';flex:1;height:1px;background:var(--line);}

.invest-box{
  background:var(--panel);
  border:1px solid var(--line);
  border-radius:10px;
  padding:20px 22px;
  display:flex;
  align-items:center;
  gap:16px;
  flex-wrap:wrap;
}
.invest-box label{font-size:.95rem;color:var(--sub);}
.invest-box input[type=number]{
  background:var(--panel2);
  border:1px solid var(--line);
  color:var(--gold);
  font-family:'JetBrains Mono',monospace;
  font-size:1.3rem;
  padding:8px 12px;
  border-radius:6px;
  width:200px;
}
.invest-box input[type=number]:focus{outline:1px solid var(--gold);}
.autobtn{
  margin-left:auto;
  background:var(--gold);
  color:#12171c;
  border:none;
  font-family:'Noto Sans TC',sans-serif;
  font-weight:700;
  font-size:.88rem;
  padding:10px 18px;
  border-radius:6px;
  cursor:pointer;
}
.autobtn:hover{background:#dcb975;}
.autobtn:focus-visible{outline:2px solid #fff;}

.etf-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;}
@media(max-width:860px){.etf-grid{grid-template-columns:1fr;}}

.etf-card{
  background:var(--panel);
  border:1px solid var(--line);
  border-radius:10px;
  padding:18px;
  display:flex;
  flex-direction:column;
  gap:10px;
  position:relative;
}
.group-badge{
  font-family:'JetBrains Mono',monospace;
  font-size:.68rem;
  color:#12171c;
  background:var(--gold);
  padding:3px 9px;
  border-radius:20px;
  align-self:flex-start;
  letter-spacing:.4px;
}
.etf-card select{
  width:100%;
  background:var(--panel2);
  color:var(--text);
  border:1px solid var(--line);
  padding:8px 10px;
  border-radius:6px;
  font-size:.92rem;
}
.etf-name{font-family:'Newsreader',serif;font-size:1.15rem;color:var(--gold);}
.etf-code{font-family:'JetBrains Mono',monospace;color:var(--sub);font-size:.78rem;}
.etf-meta{font-size:.8rem;color:var(--sub);border-top:1px solid var(--line);padding-top:8px;margin-top:2px;}
.etf-meta div{display:flex;justify-content:space-between;margin-bottom:4px;}
.etf-meta b{color:var(--text);font-family:'JetBrains Mono',monospace;font-weight:500;}
.etf-desc{font-size:.78rem;color:var(--sub);line-height:1.5;}
.shares-row{display:flex;align-items:center;gap:8px;margin-top:4px;}
.shares-row label{font-size:.8rem;color:var(--sub);white-space:nowrap;}
.shares-row input{
  width:100%;
  background:var(--panel2);
  border:1px solid var(--line);
  color:var(--gold);
  font-family:'JetBrains Mono',monospace;
  padding:7px 8px;
  border-radius:6px;
  font-size:.95rem;
}
.lot-note{font-size:.72rem;color:var(--sub);font-family:'JetBrains Mono',monospace;}
.cost-line{font-size:.85rem;display:flex;justify-content:space-between;font-family:'JetBrains Mono',monospace;}

.budget-bar{
  background:var(--panel);
  border:1px solid var(--line);
  border-radius:10px;
  padding:18px 22px;
  display:flex;
  gap:30px;
  flex-wrap:wrap;
  align-items:center;
}
.budget-item{font-family:'JetBrains Mono',monospace;}
.budget-item .lab{color:var(--sub);font-size:.72rem;text-transform:uppercase;letter-spacing:1px;display:block;margin-bottom:3px;font-family:'Noto Sans TC',sans-serif;}
.budget-item .val{font-size:1.25rem;color:var(--text);}
.budget-item .val.over{color:var(--red);}
.budget-item .val.ok{color:var(--green);}

table{width:100%;border-collapse:collapse;font-size:.85rem;}
th,td{padding:9px 10px;text-align:right;border-bottom:1px solid var(--line);}
th:first-child,td:first-child{text-align:left;}
th{color:var(--sub);font-weight:500;font-size:.72rem;text-transform:uppercase;letter-spacing:.6px;}
td{font-family:'JetBrains Mono',monospace;}
tr.total td{border-top:1px solid var(--gold-dim);border-bottom:none;color:var(--gold);font-weight:700;padding-top:12px;}
.tag-tax{color:var(--amber);font-size:.7rem;border:1px solid var(--amber);padding:1px 6px;border-radius:10px;margin-left:6px;font-family:'Noto Sans TC',sans-serif;}
.tag-safe{color:var(--green);font-size:.7rem;border:1px solid var(--green);padding:1px 6px;border-radius:10px;margin-left:6px;font-family:'Noto Sans TC',sans-serif;}

.calendar{
  display:grid;
  grid-template-columns:repeat(6,1fr);
  gap:10px;
}
@media(max-width:760px){.calendar{grid-template-columns:repeat(3,1fr);}}
.month{
  background:var(--panel);
  border:1px solid var(--line);
  border-radius:8px;
  padding:12px 10px;
  min-height:88px;
}
.month.has-pay{border-color:var(--gold-dim);background:linear-gradient(160deg,var(--panel),#242c22);}
.month .m-label{font-family:'Newsreader',serif;font-style:italic;color:var(--gold);font-size:.95rem;}
.month .m-amt{font-family:'JetBrains Mono',monospace;font-size:1.05rem;margin-top:6px;}
.month .m-tax{font-family:'JetBrains Mono',monospace;font-size:.68rem;color:var(--amber);margin-top:2px;}
.month .m-empty{color:var(--sub);font-size:.75rem;margin-top:6px;}

.notes{
  margin-top:38px;
  font-size:.78rem;
  color:var(--sub);
  border-top:1px solid var(--line);
  padding-top:16px;
  line-height:1.7;
}
.notes b{color:var(--text);}
</style>
</head>
<body>
